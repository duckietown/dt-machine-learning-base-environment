#!/usr/bin/env python3
"""Self-test of the ML environment: ONNX Runtime (always installed) and PyTorch (when installed, e.g., in
dt-machine-learning-base-pytorch).

Run it on a robot with `dts devel run -H ROBOT -L self-test`. Set ML_SELF_TEST_REQUIRE_GPU=1 to fail when no GPU
execution provider can run a model (e.g., on a Jetson where the host CUDA/TensorRT libraries are not mounted).
"""
import glob
import os
import platform
import subprocess
import sys
import time

REQUIRE_GPU = os.environ.get("ML_SELF_TEST_REQUIRE_GPU", "0") == "1"
GPU_PROVIDERS = ["TensorrtExecutionProvider", "CUDAExecutionProvider"]
failed = False

print("===============================================================")
print(f"Python {platform.python_version()} on {platform.machine()}")
for var in ("ML_PLATFORM", "CUDA_VERSION", "CUDNN_VERSION", "TENSORRT_VERSION", "ONNXRUNTIME_VERSION", "PYTORCH_VERSION"):
    print(f"+    {var}: {os.environ.get(var, '-')}")

# ONNX Runtime ------------------------------------------------------------------------------------------------------
print("---------------------------------------------------------------")
try:
    import numpy as np
    import onnxruntime as ort
except Exception as e:
    print(f"ERROR! ONNX Runtime import failed: {e}")
    sys.exit(1)
print(f"ONNX Runtime {ort.__version__}, providers built in: {ort.get_available_providers()}")
expected = os.environ.get("ONNXRUNTIME_VERSION")
if expected and ort.__version__ != expected:
    print(f"ERROR! ONNXRUNTIME_VERSION is {expected} but ONNX Runtime {ort.__version__} is installed")
    failed = True

# libraries the GPU providers need but cannot find (host-mounted on the Jetson, driver on a laptop)
capi = os.path.join(os.path.dirname(ort.__file__), "capi")
for lib in sorted(glob.glob(os.path.join(capi, "libonnxruntime_providers_*.so"))):
    try:
        out = subprocess.run(["ldd", lib], capture_output=True, text=True).stdout
    except FileNotFoundError:
        break
    missing = sorted({line.split()[0] for line in out.splitlines() if "not found" in line})
    print(f"+    {os.path.basename(lib)}: {'all libraries found' if not missing else 'missing ' + ', '.join(missing)}")

# a small convolutional model, run with each provider preference; the result is checked against numpy
try:
    from onnx import TensorProto, helper

    w = np.random.default_rng(0).standard_normal((8, 3, 3, 3)).astype(np.float32)
    graph = helper.make_graph(
        [helper.make_node("Conv", ["x", "w"], ["c"], pads=[1, 1, 1, 1]), helper.make_node("Relu", ["c"], ["y"])],
        "self_test",
        [helper.make_tensor_value_info("x", TensorProto.FLOAT, [1, 3, 32, 32])],
        [helper.make_tensor_value_info("y", TensorProto.FLOAT, [1, 8, 32, 32])],
        [helper.make_tensor("w", TensorProto.FLOAT, w.shape, w.flatten().tolist())],
    )
    model = helper.make_model(graph, opset_imports=[helper.make_opsetid("", 13)])
    model.ir_version = 7  # readable by every ONNX Runtime release this image ships (>= 1.11)
    model_bytes = model.SerializeToString()
except Exception as e:
    print(f"ERROR! could not build the test model: {e}")
    sys.exit(1)

x = np.random.default_rng(1).standard_normal((1, 3, 32, 32)).astype(np.float32)
xp = np.pad(x, ((0, 0), (0, 0), (1, 1), (1, 1)))
ref = np.zeros((1, 8, 32, 32), np.float32)
for i in range(3):
    for j in range(3):
        ref += np.einsum("oc,nchw->nohw", w[:, :, i, j], xp[:, :, i:i + 32, j:j + 32])
ref = np.maximum(ref, 0)

ran_on_gpu = False
for provider in [p for p in GPU_PROVIDERS if p in ort.get_available_providers()] + ["CPUExecutionProvider"]:
    providers = [provider] if provider == "CPUExecutionProvider" else [provider, "CPUExecutionProvider"]
    try:
        t0 = time.time()
        sess = ort.InferenceSession(model_bytes, providers=providers)
        setup = time.time() - t0
        y = sess.run(None, {"x": x})[0]
        active = sess.get_providers()[0]
    except Exception as e:
        print(f"+    {provider}: FAILED ({str(e).splitlines()[0][:160]})")
        continue
    ok = np.allclose(y, ref, atol=1e-3)
    print(f"+    {provider}: ran on {active}, result {'correct' if ok else 'WRONG'} (session setup {setup:.1f} s)")
    if not ok:
        failed = True
    if active in GPU_PROVIDERS:
        ran_on_gpu = True
print(f"ONNX Runtime GPU inference: {'yes' if ran_on_gpu else 'no (CPU only)'}")
if REQUIRE_GPU and not ran_on_gpu:
    print("ERROR! ML_SELF_TEST_REQUIRE_GPU=1 but no GPU execution provider could run the model")
    failed = True

# PyTorch (optional) ------------------------------------------------------------------------------------------------
print("---------------------------------------------------------------")
try:
    import torch
except ModuleNotFoundError:
    torch = None
    print("PyTorch: not installed (it is provided by dt-machine-learning-base-pytorch)")
except Exception as e:
    torch = None
    failed = True
    print(f"ERROR! PyTorch is installed but cannot be loaded: {e}")
    if os.environ.get("ML_PLATFORM", "").startswith("arm64v8-jetpack"):
        print("+    the Jetson PyTorch build links the CUDA libraries, which the NVIDIA container runtime mounts on a Jetson;")
        print("+    elsewhere use the arm64v8 image without the JetPack variant (it is what `dts` builds on a non-Jetson)")
if torch is not None:
    print(f"PyTorch {torch.__version__}, CUDA available: {torch.cuda.is_available()}")
    if torch.cuda.is_available():
        print(f"+    CUDA {torch.version.cuda}, cuDNN {torch.backends.cudnn.version()}, GPU {torch.cuda.get_device_name(0)}")
        try:
            torch.rand(10, device="cuda")
            print("+    write to GPU: OK")
        except Exception as e:
            print(f"ERROR! PyTorch sees the GPU but cannot use it: {e}")
            failed = True

print("===============================================================")
print("If you have any issues, please send the output above this line!")
sys.exit(1 if failed else 0)
